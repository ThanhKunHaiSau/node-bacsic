<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <meta name="description" content="Hỏi Dân IT - Dự án laptopshop" />
  <meta name="author" content="Hỏi Dân IT" />
  <title>Create Product</title>
  <link href="/admin/css/styles.css" rel="stylesheet" />
  <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js">
  </script>
  <script>
    $(document).ready(() => {
      const imageFile = $("#imageFile");
      imageFile.change(function(e) {
        const imgURL = URL.createObjectURL(e.target.files[0]);
        $("#imagePreview").attr("src", imgURL);
        $("#imagePreview").css({
          "display": "block"
        });
      });
    });
  </script>
</head>

<body class="sb-nav-fixed">
  <%- include('../layout/header.ejs') %>
  <div id="layoutSidenav">
    <%- include('../layout/sidenav.ejs') %>
    <div id="layoutSidenav_content">
      <main>
        <div class="container-fluid px-4">
          <% errors.forEach(function(error) { %>
          <div class="alert alert-danger mb-3">
            <%= error %>
          </div>

          <%  } )  %>

          <!-- Tiêu đề và breadcrumb -->
          <h1 class="mt-4">Manage Products</h1>
          <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
            <li class="breadcrumb-item active">Create Product</li>
          </ol>

          <!-- Card chứa form -->
          <div class="row justify-content-center">
            <div class="col-xl-7 col-lg-8 col-md-10">
              <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white fw-bold">
                  <i class="fas fa-laptop me-2"></i> Create New Product
                </div>
                <div class="card-body p-4">
                  <form action="/admin/products/handle-create-product" method="POST" enctype="multipart/form-data">
                    <div class="mb-3">
                      <label class="form-label">Tên sản phẩm:</label>
                      <input type="text" value="<%= oldData.name %>" name="name" class="form-control" placeholder="Nhập tên sản phẩm" required>
                    </div>

                    <div class="row">
                      <div class="mb-3 col-6">
                        <label class="form-label">Giá:</label>
                        <input type="number" value="<%= oldData.price %>" name="price" class="form-control" placeholder="Nhập giá">
                      </div>
                      <div class="mb-3 col-6">
                        <label class="form-label">Số lượng:</label>
                        <input type="number" value="<%= oldData.quantity %>" name="quantity" class="form-control" placeholder="Nhập số lượng">
                      </div>
                    </div>

                    <div class="mb-3">
                      <label class="form-label">Mô tả ngắn:</label>
                      <input type="text" value="<%= oldData.shortDesc %>" name="shortDesc" class="form-control" placeholder="Mô tả ngắn gọn">
                    </div>

                    <div class="mb-3">
                      <label class="form-label">Mô tả chi tiết:</label>
                      <textarea value="<%= oldData.detailDesc %>" name="detailDesc" class="form-control" rows="4" placeholder="Mô tả chi tiết sản phẩm"></textarea>
                    </div>

                    <div class="row">
                      <div class="mb-3 col-6">
                        <label class="form-label">Nhà sản xuất</label>
                        <select value="<%= oldData.factory %>" name="factory" class="form-select">
                          <option value="APPLE">Apple (MacBook)</option>
                          <option value="ASUS">Asus</option>
                          <option value="LENOVO">Lenovo</option>
                          <option value="DELL">Dell</option>
                          <option value="LG">LG</option>
                          <option value="ACER">Acer</option>
                        </select>
                      </div>
                      <div class="mb-3 col-6">
                        <label class="form-label">Mục đích:</label>
                        <select value="<%= oldData.target %>" name="target" class="form-select">
                          <option value="GAMING">Gaming</option>
                          <option value="SINHVIEN-VANPHONG">Sinh viên - Văn phòng
                          </option>
                          <option value="THIET-KE-DO-HOA">Thiết kế đồ họa</option>
                          <option value="MONG-NHE">Mỏng nhẹ</option>
                          <option value="DOANH-NHAN">Doanh nhân</option>
                        </select>
                      </div>
                    </div>


                    <div class="mb-3">
                      <label class="form-label">Ảnh sản phẩm:</label>
                      <input class="form-control" type="file" id="imageFile" name="image" accept=".png, .jpg, .jpeg">
                    </div>
                    <img style="max-height: 250px; display: none;" alt="product preview" id="imagePreview" />

                    <div class="d-grid mt-4">
                      <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-save me-2"></i> Create Product
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
      <%- include('../layout/footer.ejs') %>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  <script src="/admin/js/scripts.js"></script>
</body>

</html>