```ejs
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <meta name="description" content="LaptopShop Admin Dashboard" />
  <meta name="author" content="Hỏi Dân IT" />
  <title>Admin Dashboard</title>
  <link href="/admin/css/styles.css" rel="stylesheet" />
  <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="sb-nav-fixed">
  <%- include('../layout/header.ejs') %>
  <div id="layoutSidenav">
    <%- include('../layout/sidenav.ejs') %>
    <div id="layoutSidenav_content">
      <main>
        <!-- Nội dung Dashboard -->
        <div class="container-fluid px-4">
          <h1 class="mt-4 fw-bold text-primary">Dashboard</h1>
          <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item active">Tổng quan</li>
          </ol>

          <!-- Card thống kê -->
          <div class="row">
            <div class="col-xl-4 col-md-6 mb-4">
              <div class="card bg-primary text-white shadow-lg hover-card border-0 rounded-3">
                <div class="card-body">
                  <h6 class="text-uppercase fw-bold">Người dùng</h6>
                  <h2 class="fw-bolder"><%= stats.totalUsers %></h2>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                  <a class="small text-white stretched-link fw-semibold" href="/admin/user">Xem chi tiết</a>
                  <i class="fas fa-users fa-lg"></i>
                </div>
              </div>
            </div>

            <div class="col-xl-4 col-md-6 mb-4">
              <div class="card bg-success text-white shadow-lg hover-card border-0 rounded-3">
                <div class="card-body">
                  <h6 class="text-uppercase fw-bold">Đơn hàng</h6>
                  <h2 class="fw-bolder"><%= stats.totalOrders %></h2>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                  <a class="small text-white stretched-link fw-semibold" href="/admin/order">Xem chi tiết</a>
                  <i class="fas fa-shopping-cart fa-lg"></i>
                </div>
              </div>
            </div>

            <div class="col-xl-4 col-md-6 mb-4">
              <div class="card bg-warning text-white shadow-lg hover-card border-0 rounded-3">
                <div class="card-body">
                  <h6 class="text-uppercase fw-bold">Sản phẩm</h6>
                  <h2 class="fw-bolder"><%= stats.totalProducts %></h2>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                  <a class="small text-white stretched-link fw-semibold" href="/admin/product">Xem chi tiết</a>
                  <i class="fas fa-laptop fa-lg"></i>
                </div>
              </div>
            </div>
          </div>

          <!-- Biểu đồ -->
          <div class="row">
            <div class="col-xl-6 mb-4">
              <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-light fw-bold"><i class="fas fa-chart-line me-2"></i>Doanh thu theo tháng</div>
                <div class="card-body"><canvas id="revenueChart" height="120"></canvas></div>
              </div>
            </div>
            <div class="col-xl-6 mb-4">
              <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-light fw-bold"><i class="fas fa-chart-pie me-2"></i>Trạng thái đơn hàng</div>
                <div class="card-body"><canvas id="orderStatusChart" height="120"></canvas></div>
              </div>
            </div>
          </div>

          <!-- Bảng đơn hàng -->
          <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-light fw-bold"><i class="fas fa-table me-2"></i>Đơn hàng gần đây</div>
            <div class="card-body">
              <table class="table table-hover align-middle">
                <thead class="table-dark">
                  <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentOrders.forEach(order => { %>
                  <tr>
                    <td class="fw-semibold">#<%= order.id %></td>
                    <td><%= order.userName %></td>
                    <td class="text-success fw-bold">
                      <%= new Intl.NumberFormat('vi-VN',{ style:'currency', currency:'VND'}).format(order.totalPrice) %>
                    </td>
                    <td>
                      <span class="badge 
                        <%= order.status === 'PENDING' ? 'bg-warning text-dark' 
                             : order.status === 'COMPLETED' ? 'bg-success' 
                             : 'bg-danger' %> px-3 py-2 rounded-pill">
                        <%= order.status %>
                      </span>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
      <%- include('../layout/footer.ejs') %>
    </div>
  </div>

  <!-- JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  <script src="/admin/js/scripts.js"></script>



  <!-- CSS -->
  <style>
    .hover-card {
      transition: all 0.3s ease;
    }

    .hover-card:hover {
      transform: translateY(-6px) scale(1.02);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2) !important;
    }

    .card-header {
      font-size: 1rem;
      border-bottom: 1px solid #ddd;
    }
  </style>
</body>

</html>