<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update User</title>
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">
    <style>
        body {
            background-color: #f7f9fc;
            font-family: Arial, sans-serif;
        }

        .form-container {
            max-width: 600px;
            margin: 50px auto;
            background: #fff;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, .1);
        }

        .form-container h2 {
            text-align: center;
            margin-bottom: 20px;
            font-weight: bold;
        }

        .avatar-preview {
            display: block;
            margin: 10px auto;
            max-height: 200px;
            border-radius: 8px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, .2);
        }
    </style>
</head>

<body>
    <div class="form-container">
        <h2>Update User Info</h2>

        <form action="/update-user" method="POST" enctype="multipart/form-data">
            <!-- Hidden ID -->
            <input type="hidden" name="id"
                value="<%= user.id %>">

            <!-- Email / Username -->
            <div class="mb-3">
                <label for="email" class="form-label">Email address</label>
                <input type="email" id="email" name="username"
                    class="form-control"
                    value="<%= user.username || '' %>" required>
            </div>

            <!-- Full Name -->
            <div class="mb-3">
                <label for="fullName" class="form-label">Full Name</label>
                <input type="text" id="fullName" name="fullName"
                    class="form-control"
                    value="<%= user.fullName || '' %>" required>
            </div>

            <!-- Phone (fix: luôn có value rỗng nếu thiếu) -->
            <div class="mb-3">
                <label for="phone" class="form-label">Phone</label>
                <input type="text" id="phone" name="phone" class="form-control"
                    value="<%= (user && user.phone) ? user.phone: '' %>"
                    placeholder="Enter phone">
            </div>

            <!-- Role (fix: so sánh chuỗi để luôn chọn đúng, hiển thị text role.name) -->
            <div class="mb-3">
                <label for="role" class="form-label">Role</label>
                <select id="role" name="roleId" class="form-select" required>
                    <% roles.forEach(function(r) { %>
                    <option value="<%= r.id %>" <ejs>603761
                        String(user.roleId) === String(r.id) ? 'selected' : ''
                        %>>
                        <%= r.name %>
                    </option>
                    <% }) %>
                </select>
            </div>

            <!-- Password (để trống nếu không đổi) -->
            <div class="mb-3">
                <label for="password" class="form-label">Password (leave blank
                    if not changing)</label>
                <input type="password" id="password" name="password"
                    class="form-control" placeholder="Enter new password">
            </div>

            <!-- Address -->
            <div class="mb-3">
                <label for="address" class="form-label">Address</label>
                <textarea id="address" name="address" class="form-control"
                    rows="3" required>
                    <%= user.address || '' %>
                </textarea>
            </div>

            <!-- Avatar upload -->
            <div class="mb-3">
                <label for="avatarFile" class="form-label">Avatar</label>
                <input class="form-control" type="file" id="avatarFile"
                    name="avatar" accept=".png, .jpg, .jpeg">
            </div>

            <!-- Avatar Preview (đang lưu ở public/images) -->
            <% if (user.avatar) { %><img
                src="/images/<%= user.avatar %>"
                alt="User Avatar" class="avatar-preview" id="avatarPreview">
            <% } else { %><img
                src="http://localhost:3000/images/200x200?text=No+Avatar"
                alt="No Avatar" class="avatar-preview" id="avatarPreview">



            
            <% } %><button type="submit"
                class="btn btn-primary w-100 mt-3">Update</button>
        </form>
    </div>

    <script>
        // Preview ảnh khi chọn file mới
        const avatarFile = document.getElementById("avatarFile");
        const avatarPreview = document.getElementById("avatarPreview");
        avatarFile?.addEventListener("change", (e) => {
            const file = e.target.files?.[0];
            if (file) avatarPreview.src = URL.createObjectURL(file);
        });
    </script>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>
</body>

</html>