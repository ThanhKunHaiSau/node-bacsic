<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <title> Sản Phẩm - Laptopshop</title>
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <meta content="" name="keywords">
  <meta content="" name="description">

  <!-- Google Web Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Raleway:wght@600;800&display=swap" rel="stylesheet">

  <!-- Icon Font Stylesheet -->
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Libraries Stylesheet -->
  <link href="/client/lib/lightbox/css/lightbox.min.css" rel="stylesheet">
  <link href="/client/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

  <!-- Customized Bootstrap Stylesheet -->
  <link href="/client/css/bootstrap.min.css" rel="stylesheet">

  <!-- Template Stylesheet -->
  <link href="/client/css/style.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-toast-plugin/1.3.2/jquery.toast.min.css" integrity="sha512-wJgJNTBBkLit7ymC6vvzM1EcSWeM9mmOu+1USHaRBbHkm6W9EgM0HY27+UtUaprntaYQJF75rc8gjxllKs5OIQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <style>
    /* CSS cho phân trang ngang */
    .pagination.horizontal-pagination {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      padding: 10px 0;
      gap: 5px;
    }

    .pagination.horizontal-pagination .page-item {
      white-space: nowrap;
      flex-shrink: 0;
    }

    .pagination.horizontal-pagination .page-link {
      min-width: 40px;
      text-align: center;
      padding: 8px 12px;
    }

    /* Custom scrollbar cho phân trang */
    .pagination.horizontal-pagination::-webkit-scrollbar {
      height: 4px;
    }

    .pagination.horizontal-pagination::-webkit-scrollbar-track {
      background: #f1f1f1;
    }

    .pagination.horizontal-pagination::-webkit-scrollbar-thumb {
      background: #888;
      border-radius: 2px;
    }

    .pagination.horizontal-pagination::-webkit-scrollbar-thumb:hover {
      background: #555;
    }
  </style>
</head>

<body>

  <!-- Spinner Start -->
  <div id="spinner" class="show w-100 vh-100 bg-white position-fixed translate-middle top-50 start-50  d-flex align-items-center justify-content-center">
    <div class="spinner-grow text-primary" role="status"></div>
  </div>
  <!-- Spinner End -->

  <%- include('../layout/header'); -%>
  <div class="py-1"></div>

  <!-- Single Product Start -->
  <div class="container-fluid py-5 mt-5">
    <div class="container py-5">
      <div class="row g-4 mb-5">
        <div>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="/">Home</a></li>
              <li class="breadcrumb-item active" aria-current="page">Danh Sách Sản Phẩm
              </li>
            </ol>
          </nav>
        </div>

        <div class="row g-4 fruite">
          <!-- Sidebar Filter -->
          <div class="col-12 col-md-4">
            <div class="row g-4">
              <!-- Hãng sản xuất -->
              <div class="col-12 " id="factoryFilter">
                <div class="mb-2"><b>Hãng sản xuất</b></div>
                <% ['APPLE', 'ASUS', 'LENOVO', 'DELL', 'LG', 'ACER'].forEach((brand, idx) => { %>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" id="factory-<%= idx+1 %>" value="<%= brand %>">
                  <label class="form-check-label" for="factory-<%= idx+1 %>"><%= brand.charAt(0) + brand.slice(1).toLowerCase() %></label>
                </div>
                <% }) %>
              </div>

              <!-- Mục đích sử dụng -->
              <div class="col-12" id="targetFilter">
                <div class="mb-2"><b>Mục đích sử dụng</b></div>
                <% ['GAMING', 'SINHVIEN-VANPHONG', 'THIET-KE-DO-HOA', 'MONG-NHE', 'DOANH-NHAN'].forEach((target, idx) => { %>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" id="target-<%= idx+1 %>" value="<%= target %>">
                  <label class="form-check-label" for="target-<%= idx+1 %>"><%= target.replace('-', ' ').toLowerCase().replace(/\b\w/g, l => l.toUpperCase()) %></label>
                </div>
                <% }) %>
              </div>

              <!-- Mức giá -->
              <div class="col-12" id="priceFilter">
                <div class="mb-2"><b>Mức giá</b></div>
                <% ['duoi-10-trieu', '10-15-trieu', '15-20-trieu', 'tren-20-trieu'].forEach((price, idx) => { %>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" id="price-<%= idx+2 %>" value="<%= price %>">
                  <label class="form-check-label" for="price-<%= idx+2 %>"><%= price.replace('-', ' ').replace('trieu', 'triệu') %></label>
                </div>
                <% }) %>
              </div>

              <!-- Sắp xếp -->
              <div class="col-12">
                <div class="mb-2"><b>Sắp xếp</b></div>
                <% [['gia-tang-dan','Giá tăng dần'], ['gia-giam-dan','Giá giảm dần'], ['gia-nothing','Không sắp xếp']].forEach((sort, idx) => { %>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" id="sort-<%= idx+1 %>" value="<%= sort[0] %>" name="radio-sort" checked>
                  <label class="form-check-label" for="sort-<%= idx+1 %>"><%= sort[1] %></label>
                </div>
                <% }) %>
              </div>

              <div class="col-12">
                <button id="btnFilter" class="btn border-secondary rounded-pill px-4 py-3 text-primary text-uppercase mb-4">
                  Lọc Sản Phẩm
                </button>
              </div>
            </div>
          </div>

          <!-- Product List -->
          <div class="col-12 col-md-8 text-center">
            <div class="row g-4">
              <% products.forEach(function(product) { %>
              <div class="col-md-6 col-lg-4">
                <div class="rounded position-relative fruite-item">
                  <div class="fruite-img">
                    <img src="../images/products/<%= product.image %>" class="img-fluid w-100 rounded-top" alt="">
                  </div>
                  <div class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px;">Laptop</div>
                  <div class="p-4 border border-secondary border-top-0 rounded-bottom">
                    <h4 style="font-size: 15px;">
                      <a href="/product/<%= product.id %>"><%= product.name %></a>
                    </h4>
                    <p style="font-size: 13px;"><%= product.shortDesc %></p>
                    <div class="d-flex flex-lg-wrap justify-content-center">
                      <p style="font-size: 15px; text-align: center; width: 100%;" class="text-dark fs-5 fw-bold mb-3">
                        <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(product.price) %>
                      </p>
                      <form method="post" action="/add-product-to-cart/<%= product.id %>">
                        <button class="mx-auto btn border border-secondary rounded-pill px-3 text-primary">
                          <i class="fa fa-shopping-bag me-2 text-primary"></i>
                          Add to cart
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
              <% }); %>

              <!-- Pagination Start -->
              <nav aria-label="Page navigation" class="mt-5">
                <ul class="pagination horizontal-pagination justify-content-center">
                  <!-- Previous -->
                  <li class="page-item <%= pagination.page === 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="/products?page=<%= pagination.page - 1 %>" aria-label="Previous">&laquo;</a>
                  </li>

                  <!-- Page Numbers -->
                  <% for(let i = 1; i <= pagination.totalPages; i++) { %>
                  <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                    <a class="page-link" href="/products?page=<%= i %>">
                      <%= i %>
                    </a>
                  </li>
                  <% } %>

                  <!-- Next -->
                  <li class="page-item <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>">
                    <a class="page-link" href="/products?page=<%= pagination.page + 1 %>" aria-label="Next">&raquo;</a>
                  </li>
                </ul>
              </nav>
              <!-- Pagination End -->

            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
  <!-- Single Product End -->

  <%- include('../layout/footer'); -%>

  <!-- Back to Top -->
  <a href="#" class="btn btn-primary border-3 border-primary rounded-circle back-to-top"><i class="fa fa-arrow-up"></i></a>

  <!-- JavaScript Libraries -->
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/client/lib/easing/easing.min.js"></script>
  <script src="/client/lib/waypoints/waypoints.min.js"></script>
  <script src="/client/lib/lightbox/js/lightbox.min.js"></script>
  <script src="/client/lib/owlcarousel/owl.carousel.min.js"></script>

  <!-- Template Javascript -->
  <script src="/client/js/main.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-toast-plugin/1.3.2/jquery.toast.min.js" integrity="sha512-zlWWyZq71UMApAjih4WkaRpikgY9Bz1oXIW5G0fED4vk14JjGlQ1UmkGM392jEULP8jbNMiwLWdM8Z87Hu88Fw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

</body>

</html>