<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <title><%= product.name %></title>
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <meta content="" name="keywords">
  <meta content="" name="description">
  <!-- Google Web Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Raleway:wght@600;800&display=swap" rel="stylesheet">
  <!-- Icon Font Stylesheet -->
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
  <!-- Libraries Stylesheet -->
  <link href="../client/lib/lightbox/css/lightbox.min.css" rel="stylesheet">
  <link href="../client/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
  <!-- Customized Bootstrap Stylesheet -->
  <link href="../client/css/bootstrap.min.css" rel="stylesheet">
  <!-- Template Stylesheet -->
  <link href="../client/css/style.css" rel="stylesheet">
  <style>
    img.rounded:hover {
      transform: scale(1.03);
      transition: all 0.3s ease;
    }

    /* Tab đẹp hơn */
    .nav-tabs .nav-link {
      border: none;
      font-weight: 600;
      color: #555;
    }

    .nav-tabs .nav-link.active {
      color: #0d6efd;
      border-bottom: 3px solid #0d6efd;
    }
  </style>
</head>

<body>
  <!-- Spinner Start -->
  <div id="spinner" class="show w-100 vh-100 bg-white position-fixed translate-middle top-50 start-50  d-flex align-items-center justify-content-center">
    <div class="spinner-grow text-primary" role="status"></div>
  </div>
  <!-- Spinner End -->
  <!-- Navbar start -->
  <%- include('../layout/header.ejs') %>

  <!-- Hero Start -->
  <%- include("../layout/banner") %>
  <!-- Hero End -->
  <!-- Single Product Start -->
  <<div class="container-fluid py-5 mt-5">
    <div class="container py-5">
      <div class="row g-5">

        <!-- Hình ảnh sản phẩm -->
        <div class="col-lg-6">
          <div class="border rounded p-3 bg-white shadow-sm">
            <img src="/images/products/<%= product.image %>" class="img-fluid w-100 rounded" style="max-height:400px; object-fit:cover;" alt="<%= product.name %>">
          </div>
        </div>

        <!-- Thông tin sản phẩm -->
        <div class="col-lg-6">
          <h2 class="fw-bold mb-3"><%= product.name %></h2>
          <p class="text-muted mb-3"><%= product.shortDesc %></p>
          <h4 class="fw-bold text-primary mb-3">
            <%= new Intl.NumberFormat('vi-VN', {
                 style: 'currency' , currency: 'VND'
              }).format(product.price) %>
          </h4>

          <!-- Rating -->
          <div class="d-flex align-items-center mb-4">
            <i class="fa fa-star text-warning me-1"></i>
            <i class="fa fa-star text-warning me-1"></i>
            <i class="fa fa-star text-warning me-1"></i>
            <i class="fa fa-star text-warning me-1"></i>
            <i class="fa fa-star text-secondary"></i>
            <span class="ms-2 small">(120 reviews)</span>
          </div>

          <!-- Chọn số lượng -->
          <div class="d-flex align-items-center mb-4">
            <button class="btn btn-sm btn-light border rounded-circle me-2">
              <i class="fa fa-minus"></i>
            </button>
            <input type="text" class="form-control form-control-sm text-center border-secondary" style="width:60px;" value="1">
            <button class="btn btn-sm btn-light border rounded-circle ms-2">
              <i class="fa fa-plus"></i>
            </button>
          </div>

          <!-- Nút add to cart -->
          <a href="#" class="btn btn-primary rounded-pill px-4 py-2">
            <i class="fa fa-shopping-bag me-2"></i> Add to Cart
          </a>
        </div>
      </div>

      <!-- Tabs mô tả -->
      <div class="row mt-5">
        <div class="col-lg-12">
          <ul class="nav nav-tabs" id="productTab" role="tablist">
            <li class="nav-item">
              <button class="nav-link active" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button" role="tab">Description</button>
            </li>
            <li class="nav-item">
              <button class="nav-link" id="review-tab" data-bs-toggle="tab" data-bs-target="#review" type="button" role="tab">Reviews</button>
            </li>
          </ul>

          <div class="tab-content border p-4 bg-white rounded-bottom shadow-sm" id="productTabContent">
            <div class="tab-pane fade show active" id="desc" role="tabpanel">
              <p><%= product.detailDesc %></p>
            </div>
            <div class="tab-pane fade" id="review" role="tabpanel">
              <p class="text-muted">No reviews yet. Be the first to review this product!</p>
            </div>
          </div>
        </div>
      </div>

    </div>
    </div>

    </div>
    <!-- Single Product End -->


    <!-- Footer Start -->
    <%- include("../layout/footer") %>



    <a href="#" class="btn btn-primary border-3 border-primary rounded-circle back-to-top"><i class="fa fa-arrow-up"></i></a>


    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js">
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js">
    </script>
    <script src="../client/lib/easing/easing.min.js"></script>
    <script src="../client/lib/waypoints/waypoints.min.js"></script>
    <script src="../client/lib/lightbox/js/lightbox.min.js"></script>
    <script src="../client/lib/owlcarousel/owl.carousel.min.js"></script>

    <script src="../client/js/main.js"></script>
</body>

</html>