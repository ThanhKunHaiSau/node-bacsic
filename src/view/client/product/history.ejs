```ejs
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <title>Lịch sử mua hàng</title>
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Raleway:wght@600;800&display=swap" rel="stylesheet">
  <!-- Icon Font Stylesheet -->
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
  <!-- Bootstrap Stylesheet -->
  <link href="../client/css/bootstrap.min.css" rel="stylesheet">
  <!-- Template Stylesheet -->
  <link href="../client/css/style.css" rel="stylesheet">
</head>

<body>
  <!-- Header -->
  <%- include('../layout/header.ejs') %>
  <!-- Banner -->
  <%- include('../layout/banner') %>

  <div class="container-fluid py-5">
    <div class="container py-5">
      <h2 class="mb-5 text-center">Lịch sử mua hàng</h2>

      <% if (orders && orders.length > 0) { %>
      <% orders.forEach(order => { %>
      <div class="card shadow-sm mb-5">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <span>Đơn hàng #<%= order.id %></span>
          <span>Trạng thái: <strong><%= order.status %></strong></span>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table align-middle">
              <thead>
                <tr>
                  <th scope="col">Sản phẩm</th>
                  <th scope="col">Tên</th>
                  <th scope="col">Giá</th>
                  <th scope="col">Số lượng</th>
                  <th scope="col">Thành tiền</th>
                </tr>
              </thead>
              <tbody>
                <% order.orderDetails.forEach(detail => { %>
                <tr>
                  <td>
                    <img src="images/products/<%= detail.product.image %>" alt="<%= detail.product.name %>" class="rounded" style="width:80px; height:80px;">
                  </td>
                  <td>
                    <a href="/product/<%= detail.product.id %>" target="_blank">
                      <%= detail.product.name %>
                    </a>
                  </td>
                  <td>
                    <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(detail.product.price) %>
                  </td>
                  <td>
                    <%= detail.quantity || 1 %>
                    <!-- nếu chưa có quantity thì mặc định 1 -->
                  </td>
                  <td>
                    <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' })
              .format((detail.quantity || 1) * detail.product.price) %>
                  </td>
                </tr>
                <% }) %>
              </tbody>

            </table>
          </div>
          <div class="d-flex justify-content-end mt-3">
            <h5 class="me-3">Tổng cộng:</h5>
            <h5 class="text-primary">
              <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(order.totalPrice) %>
            </h5>
          </div>
        </div>
      </div>
      <% }) %>
      <% } else { %>
      <p class="text-center">Bạn chưa có đơn hàng nào.</p>
      <% } %>
    </div>
  </div>

  <!-- Footer -->
  <%- include('../layout/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="../client/js/main.js"></script>
</body>

</html>
```